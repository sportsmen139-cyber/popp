# Placeholder browser configuration only. This file does not enable Supabase.
# Vite exposes every VITE_* value in the public client bundle.
# Never add a bot token, password, signing key, service_role or secret API key here.
# The reserved .invalid URL is intentionally unusable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.invalid
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
