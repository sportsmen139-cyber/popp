{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "tasks": {
    "check": "deno check telegram-auth/index.ts tests/*_test.ts",
    "test": "deno test --deny-env --deny-net --deny-read --deny-write --deny-run tests/",
    "lint": "deno lint",
    "fmt:check": "deno fmt --check"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "lineWidth": 88
  }
}
